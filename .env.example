# Shared development dotenv. Backend ignores Compose/frontend-only keys.
ENVIRONMENT=development
POSTGRES_DB=building_service
POSTGRES_USER=building_service
POSTGRES_PASSWORD=building_service
DATABASE_URL=postgresql+asyncpg://building_service:building_service@localhost:5433/building_service
JWT_SECRET_KEY=development-only-change-this-secret
PUBLIC_BASE_URL=http://localhost:5173
# Blank derives PUBLIC_BASE_URL + /staff/setup-password. STAFF_LOGIN_URL is unused.
STAFF_ACTIVATION_URL=
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Configure your SMTP provider. Blank SMTP_HOST disables email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=Building Care <no-reply@example.com>

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=building-service-images
R2_PRESIGNED_URL_EXPIRE_SECONDS=900
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=15
R2_TOTAL_MAX_ATTEMPTS=2
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_GUEST_IMAGES=5
MAX_IMAGE_PIXELS=8000000
MAX_IMAGE_PROCESSING_CONCURRENCY=1
