# Production settings. On the server: cp .env.production.example .env && chmod 600 .env
# Never commit the filled-in copy. Values marked REQUIRED stop `docker compose` when empty.

# Makes plain `docker compose ...` use the production stack on this server.
COMPOSE_FILE=compose.production.yaml
COMPOSE_PROJECT_NAME=building-care

# --- Domain (REQUIRED) -------------------------------------------------------
# Printed inside every QR code: set the final domain BEFORE printing QR signs.
PUBLIC_BASE_URL=https://care.example.ac.th
BACKEND_CORS_ORIGINS=["https://care.example.ac.th"]
# Blank = PUBLIC_BASE_URL + /staff/setup-password
STAFF_ACTIVATION_URL=

# --- Secrets (REQUIRED) ------------------------------------------------------
# Generate each with: openssl rand -hex 32   (use hex: no characters that break the DB URL)
# Do not change after go-live: JWT logs everyone out, IMAGE_URL breaks every image link,
# POSTGRES_PASSWORD is only applied when the database volume is first created.
POSTGRES_DB=building_service
POSTGRES_USER=building_service
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
IMAGE_URL_SECRET=

# --- Email (SMTP) ------------------------------------------------------------
# Blank SMTP_HOST disables email: staff invitations/reset links and guest tracking
# emails will not be sent. Gmail: smtp.gmail.com + an App password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=CS Building Care <no-reply@example.ac.th>

# --- Image storage: Cloudflare R2 (REQUIRED) ---------------------------------
# Private bucket + API token with Object Read & Write on that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=building-service-images

# --- Optional ----------------------------------------------------------------
# Host port the frontend container listens on (127.0.0.1 only).
FRONTEND_PORT=8080
