# Production settings for the server.
# `./deploy/bcare.sh install` copies this to .env (mode 600), fills the three random
# secrets, then lists every REPLACE_* value that is still left for you to fill in.
# .env is ignored by Git. Never put secrets in VITE_* (they end up in the browser).

# Makes plain `docker compose ...` use the production stack on this server.
COMPOSE_FILE=compose.production.yaml

ENVIRONMENT=production
APP_NAME="CS Building Care"
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=https://REPLACE_DOMAIN.example.org
BACKEND_CORS_ORIGINS=["https://REPLACE_DOMAIN.example.org"]
# Blank URLs derive from PUBLIC_BASE_URL; leave blank for the current frontend routes.
STAFF_ACTIVATION_URL=
STAFF_PASSWORD_RESET_URL=

# Frontend build argument / process environment. Requires rebuild after changing.
# Root dotenv is not automatically loaded by Vite in Frontend/.
VITE_API_BASE_URL=/api/v1
# Optional frontend overrides: blank uses VITE_API_BASE_URL + the endpoint path.
# If needed, pass these explicitly at build time; Dockerfile only declares the base arg.
VITE_CLEANING_REQUEST_URL=
VITE_REPAIR_REQUEST_URL=

POSTGRES_DB=building_service
POSTGRES_USER=building_service
# Random hex only (it is placed inside a URL). Docker builds DATABASE_URL from these three.
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD

# Generate two independent random secrets, at least 32 characters each.
# Short placeholders deliberately fail the existing production validator.
JWT_SECRET_KEY=REPLACE_JWT_SECRET
IMAGE_URL_SECRET=REPLACE_IMAGE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INVITATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_IP_WINDOW_SECONDS=900
# Failed logins before HTTP 429: per client IP + email, and per client IP.
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# Required. Private Cloudflare R2 bucket for photos (guest lost/found reports always
# include one). Limit the token to Object Read/Write for this bucket.
R2_ACCOUNT_ID=REPLACE_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_R2_BUCKET_NAME
R2_PRESIGNED_URL_EXPIRE_SECONDS=28800
IMAGE_REDIRECT_URL_EXPIRE_SECONDS=300
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=15
R2_TOTAL_MAX_ATTEMPTS=2

# Recommended. To run without email, blank SMTP_HOST/USERNAME/PASSWORD (keep MAIL_FROM set).
# Mail is always sent with STARTTLS on port 587 (fixed in compose.production.yaml;
# implicit TLS on 465 and unencrypted SMTP are not allowed in production).
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM="CS Building Care <REPLACE_SENDER@example.org>"
GUEST_EMAIL_PER_RECIPIENT_LIMIT=5
GUEST_EMAIL_PER_RECIPIENT_WINDOW_SECONDS=3600

# Preserve current application defaults and single-worker resource limits.
# Upload limit x count + multipart overhead must fit Nginx client_max_body_size.
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_GUEST_IMAGES=5
MAX_IMAGE_PIXELS=50000000
IMAGE_MAX_DIMENSION=2048
IMAGE_WEBP_QUALITY=78
MAX_IMAGE_OUTPUT_BYTES=1048576
MAX_IMAGE_PROCESSING_CONCURRENCY=1
DEFAULT_CUSTODY_LOCATION="ห้องธุรการ ชั้น 1"

# Docker network shared by Nginx and the backend. Both trust X-Forwarded-For only from
# it, so logs and rate limits see real client IPs. Change only if it overlaps another
# network on this host.
APP_SUBNET=172.30.80.0/24

# No admin credentials here: `./deploy/bcare.sh install` asks for the first admin.

# Production Docker resources. Default frontend access is host-local for an edge proxy.
PRODUCTION_PROJECT_NAME=cs-building-care-production
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
# Keep stable; intentionally separate from the development volume.
POSTGRES_VOLUME_NAME=cs_building_care_production_postgres_data
