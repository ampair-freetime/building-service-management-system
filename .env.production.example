# Copy to .env.production, fill secrets, and use --env-file .env.production.
# Production dotenv must never be committed or copied into a Docker image.
ENVIRONMENT=production
POSTGRES_DB=building_service
POSTGRES_USER=building_service
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
PUBLIC_BASE_URL=https://care.your-domain.example
STAFF_ACTIVATION_URL=
# Empty = PUBLIC_BASE_URL + /staff/reset-password
STAFF_PASSWORD_RESET_URL=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_IP_WINDOW_SECONDS=900
# Compose sets * for the internal Nginx; for non-Docker runs use the proxy's address.
# FORWARDED_ALLOW_IPS=127.0.0.1
BACKEND_CORS_ORIGINS=["https://care.your-domain.example"]
VITE_API_BASE_URL=/api/v1
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
# For non-Docker runs, set a URL pointing to the department's PostgreSQL server.
DATABASE_URL=

# Leave host blank until SMTP/relay availability is known; invitations report failure.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=Building Care <no-reply@your-domain.example>

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=building-service-images
R2_PRESIGNED_URL_EXPIRE_SECONDS=900
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=15
R2_TOTAL_MAX_ATTEMPTS=2
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_GUEST_IMAGES=5
MAX_IMAGE_PIXELS=8000000
MAX_IMAGE_PROCESSING_CONCURRENCY=1
